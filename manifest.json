{
  "manifest_version": 3,
  "name": "RedStream",
  "version": "1.0",
  "description": "Background Scraper and Aggregator for RedGifs with a premium custom dashboard.",
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.redgifs.com/*",
    "*://redgifs.l8tenever.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Open RedStream Dashboard"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.redgifs.com/*"
      ],
      "js": [
        "main_world_hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.redgifs.com/*"
      ],
      "js": [
        "content_script.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://redgifs.l8tenever.com/Nina/*"
      ],
      "js": [
        "l8tenever_content_script.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": [
        "*://redgifs.l8tenever.com/Nina/*"
      ],
      "js": [
        "l8tenever_main_world.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}